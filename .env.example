# ── Server (packages/server) ─────────────────────────────
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# ── Web (packages/web) — Vite exposes only VITE_* vars ────
VITE_SERVER_URL=http://localhost:3001

# ── Supabase (XOB: Project → Settings → API) ─────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google login is enabled in the Supabase dashboard:
#   Authentication → Providers → Google (paste Google Client ID + Secret).
#   Add the redirect URL Supabase shows there into Google Cloud Console.
#   Nothing else is needed in this file for Google to work.

# ── AI quiz generation (packages/server) ─────────────────
# Optional — host's "generate from topic" falls back to demo/mock questions
# when this is unset, so the app runs fine without it.
ANTHROPIC_API_KEY=
